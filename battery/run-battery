#!/usr/bin/env bash
# run-battery — compile every program in src/ for the native arch, decompile each
# through EmberDragon (--collapse), and report compile / decompile health.
#   ./run-battery            # compile + decompile all, print the summary table
#   ./run-battery <name>     # just one (e.g. ./run-battery quicksort)
set -uo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
dec="$here/.."                       # the decompiler tools live one level up
ember="$dec/emberdragon"
mkdir -p "$here/bin" "$here/out"
filter="${1:-}"

printf "%-26s %-8s %5s %5s %5s %5s  %s\n" "PROGRAM" "BUILD" "SRC" "OUT" "FNS" "UNK" "CAT"
printf '%.0s-' {1..78}; echo

n=0; built=0; clean=0; total_unk=0
for f in "$here"/src/*.c "$here"/src/*.cpp; do
  [ -e "$f" ] || continue
  base="$(basename "$f")"; name="${base%.*}"; ext="${base##*.}"
  [ -n "$filter" ] && [ "$name" != "$filter" ] && continue
  n=$((n+1))
  cc=clang; std=c11; [ "$ext" = cpp ] && { cc=clang++; std=c++17; }
  if "$cc" -std=$std -O0 "$f" -o "$here/bin/$name" 2>"$here/out/$name.build.log"; then
    build=ok; built=$((built+1))
  else
    build=FAIL
    printf "%-26s %-8s %5s %5s %5s %5s\n" "$name" "$build" "-" "-" "-" "-"
    continue
  fi
  src=$(grep -cve '^[[:space:]]*$' "$f")                       # non-blank source lines
  "$ember" "$here/bin/$name" --collapse > "$here/out/$name.c" 2>"$here/out/$name.dec.log"
  out=$(grep -cve '^[[:space:]]*$' "$here/out/$name.c")
  fns=$(grep -cE '^\w.*\(.*\) \{' "$here/out/$name.c")
  unk=$(grep -cE '\.word|\.byte' "$here/out/$name.c")          # instructions the lifter couldn't decode
  total_unk=$((total_unk+unk)); [ "$unk" = 0 ] && clean=$((clean+1))
  cat=$(python3 -c "import json,sys;print(next((m['cat'] for m in json.load(open('$here/manifest.json')) if m['file']=='$base'),''))" 2>/dev/null)
  printf "%-26s %-8s %5s %5s %5s %5s  %s\n" "$name" "$build" "$src" "$out" "$fns" "$unk" "$cat"
done
printf '%.0s-' {1..78}; echo
echo "programs=$n  built=$built  zero-unknown-decode=$clean  total-undecoded-instrs=$total_unk"
echo "decompiled sources -> $here/out/<name>.c"
