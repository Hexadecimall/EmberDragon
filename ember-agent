#!/usr/bin/env python3
# ember-agent — EmberDragon's resident AI BRAIN.
#
# Not a one-shot pass (that's ember-ai / ember-ask). This is an AGENT: it
# understands English, and it autonomously RUNS TOOLS in a loop until the job is
# done — disassemble, lift, structure, match, name, rewrite, read/write files,
# run shell — with full control over the decompiler workspace. It lives in the
# backend (on by default) and has its own chat window. A deep setting toggles it
# off (then the decompiler falls back to the local/none AI path).
#
#   ember-agent                      # interactive chat window (REPL)
#   ember-agent --once "decompile foo.o and tell me what it does"
#   ember-agent --selftest           # exercise the tool loop with NO network/key
#   ember-agent --status | --on | --off    # the deep on/off setting
#
# Deps: python3 stdlib ONLY (urllib + subprocess) — no pip, the same pattern as
# ember-ai. Auth: ANTHROPIC_API_KEY from the environment (never stored in-repo).
# Model: $NXAI_MODEL (default claude-opus-4-8).
#
# SAFETY: for now the agent auto-executes its tools with full control — Gideon's
# call, since only we have access. Public-release safety filters come later; the
# hook is execute_tool() (gate/confirm/allowlist there).
import os, sys, json, subprocess, shlex, time
import urllib.request, urllib.error

HERE      = os.path.dirname(os.path.abspath(__file__))
WORKDIR   = os.environ.get("EMBER_WORKDIR", HERE)        # the software it controls
CONF      = os.path.join(HERE, ".ember-agent.conf")
MODEL     = os.environ.get("NXAI_MODEL", "claude-opus-4-8")
API_URL   = "https://api.anthropic.com/v1/messages"
MAX_TOKENS = 16000
MAX_STEPS  = 40                                          # tool-loop safety bound per turn

C = {"r":"\033[0m","b":"\033[1m","dim":"\033[2m","cy":"\033[36m",
     "gr":"\033[32m","ye":"\033[33m","mg":"\033[35m","rd":"\033[31m"}
def color(on=True):
    if not on or not sys.stdout.isatty():
        for k in C: C[k] = ""
color()

# ─────────────────────────── the deep on/off setting ───────────────────────────
def load_conf():
    cfg = {"enabled": "true"}
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1); cfg[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return cfg
def save_conf(cfg):
    with open(CONF, "w") as f:
        f.write("# ember-agent backend settings (deep)\n")
        for k, v in cfg.items(): f.write("%s=%s\n" % (k, v))
def is_enabled():
    return load_conf().get("enabled", "true").lower() in ("1","true","yes","on")

# ─────────────────────────── tools (full control) ───────────────────────────
def _resolve(p):
    return p if os.path.isabs(p) else os.path.join(WORKDIR, p)

def tool_run_shell(command, timeout=180):
    try:
        r = subprocess.run(command, shell=True, cwd=WORKDIR, capture_output=True,
                           text=True, timeout=timeout)
        out = (r.stdout or "") + (("\n[stderr]\n" + r.stderr) if r.stderr else "")
        out = out if out.strip() else "(no output)"
        return "exit=%d\n%s" % (r.returncode, out[:20000])
    except subprocess.TimeoutExpired:
        return "error: command timed out after %ds" % timeout
    except Exception as e:
        return "error: %s" % e

def tool_read_file(path, max_bytes=60000):
    try:
        with open(_resolve(path), "rb") as f:
            data = f.read(max_bytes + 1)
        txt = data[:max_bytes].decode("utf-8", "replace")
        if len(data) > max_bytes: txt += "\n...[truncated]"
        return txt
    except Exception as e:
        return "error: %s" % e

def tool_write_file(path, content):
    try:
        full = _resolve(path)
        os.makedirs(os.path.dirname(full) or ".", exist_ok=True)
        with open(full, "w") as f:
            f.write(content)
        return "wrote %d bytes to %s" % (len(content), path)
    except Exception as e:
        return "error: %s" % e

def tool_list_dir(path="."):
    try:
        full = _resolve(path)
        entries = sorted(os.listdir(full))
        out = []
        for e in entries:
            fp = os.path.join(full, e)
            out.append(("%s/" % e) if os.path.isdir(fp) else "%s (%d)" % (e, os.path.getsize(fp)))
        return "\n".join(out) if out else "(empty)"
    except Exception as e:
        return "error: %s" % e

TOOLS = [
    {"name": "run_shell",
     "description": "Run a shell command in the EmberDragon workspace. This is how you drive the whole decompiler — the ember toolchain (ember-dis, ember-lift, ember-arm64, ember-collapse, ember-match, ember-local, ember-sigs, ember-rename, ember-ai, ember-name) all live here and are run this way. Returns exit code + combined stdout/stderr.",
     "input_schema": {"type":"object","properties":{"command":{"type":"string","description":"the shell command"}},"required":["command"]}},
    {"name": "read_file",
     "description": "Read a file (text) from the workspace. Use for inspecting binaries' disassembly dumps, lifted C, corpus records, source, etc.",
     "input_schema": {"type":"object","properties":{"path":{"type":"string"}},"required":["path"]}},
    {"name": "write_file",
     "description": "Write/overwrite a text file in the workspace (e.g. save recovered/rewritten C source).",
     "input_schema": {"type":"object","properties":{"path":{"type":"string"},"content":{"type":"string"}},"required":["path","content"]}},
    {"name": "list_dir",
     "description": "List a directory in the workspace.",
     "input_schema": {"type":"object","properties":{"path":{"type":"string","description":"default '.'"}},"required":[]}},
]
DISPATCH = {
    "run_shell":  lambda i: tool_run_shell(i.get("command","")),
    "read_file":  lambda i: tool_read_file(i.get("path","")),
    "write_file": lambda i: tool_write_file(i.get("path",""), i.get("content","")),
    "list_dir":   lambda i: tool_list_dir(i.get("path",".")),
}
def execute_tool(name, tool_input):
    # ← public-release safety filters / allowlist / confirm hook goes HERE.
    fn = DISPATCH.get(name)
    if not fn: return "error: unknown tool '%s'" % name
    return fn(tool_input)

SYSTEM = ("You are EmberDragon's resident decompilation AI — you live in the backend of the "
  "EmberDragon decompiler and have full control over its toolchain in the workspace at "
  + WORKDIR + ".\n\n"
  "EmberDragon turns a compiled/stripped binary into clean, named, commented C/C++. The "
